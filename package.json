{
  "name": "gestion-ventas",
  "productName": "Gestion De Ventas",
  "private": true,
  "version": "1.3.1",
  "description": "Gestion De Ventas",
  "author": "Julio_GE",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "electron:dev": "npm run build && electron .",
    "electron:package": "npm run build && npx @electron/packager . GestionDeVentas --overwrite --out=electron-release --ignore=\"^/src$\" --ignore=\"^/public$\" --ignore=\"^/electron-release$\" --ignore=\"^/dev-server$\" --ignore=\"^/dist-installer$\" --ignore=\"^/android$\"",
    "electron:build": "npm run build && electron-builder",
    "electron:installer": "npm run build && electron-builder --win nsis --publish never",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:add:android": "npx cap add android"
  },
  "build": {
    "appId": "app.lovable.7b113e7c315e4432bc9cae4b8cf017db",
    "productName": "GestionDeVentas",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GestionDeVentas",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "license": "build/LICENSE.txt",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": "GestionDeVentas"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76",
    "@tanstack/react-query": "^5.51.21",
    "lucide-react": "^0.462.0",
    "sonner": "^1.5.0",
    "class-variance-authority": "^0.7.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-scroll-area": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-slider": "^1.1.3",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-hover-card": "^1.1.3",
    "@radix-ui/react-navigation-menu": "^1.1.3",
    "@radix-ui/react-menubar": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-accordion": "^1.1.3",
    "qrcode": "1.5.4",
  },
  "devDependencies": {
    "electron-builder": "^25.1.8",
    "vite": "^5.4.19",
    "typescript": "^5.8.3",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.10"
  }
}

