{
  "name": "gestion-ventas",
  "productName": "Gestion De Ventas",
  "private": true,
  "version": "1.3.6",
  "description": "Gestion De Ventas",
  "author": "Julio_GE",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "electron:dev": "npm run build && electron .",
    "electron:package": "npm run build && npx @electron/packager . GestionDeVentas --overwrite --out=electron-release --ignore=\"^/src$\" --ignore=\"^/public$\" --ignore=\"^/electron-release$\" --ignore=\"^/dev-server$\" --ignore=\"^/dist-installer$\" --ignore=\"^/android$\"",
    "electron:build": "npm run build && electron-builder",
    "electron:installer": "npm run build && electron-builder --win nsis --publish never",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:add:android": "npx cap add android"
  },
  "build": {
    "appId": "app.gestion.ventas",
    "productName": "Gestion De Ventas",
    "directories": {
      "output": "dist-installer",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "installerHeader": "resources/header.bmp",
      "installerSidebar": "resources/installersidebar.bmp",
      "installerSidebarRight": true,
      "uninstallerSidebar": "resources/installersidebar.bmp",
      "license": "resources/license.txt",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gestion De Ventas",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": "GestionDeVentas",
      "language": "es_ES",
      "multiLanguageInstaller": false,
      "displayLanguageSelector": false
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.1.3",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.1.3",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.1.3",
    "@radix-ui/react-navigation-menu": "^1.1.3",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.1.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.51.21",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.1.7",
    "embla-carousel-react": "^8.6.0",
    "html5-qrcode": "^2.3.8",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "lz-string": "^1.5.0",
    "next-themes": "^0.3.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "lovable-tagger": "^1.1.13",
    "vite": "^5.4.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.10",
    "vitest": "^3.2.4"
  }
}
